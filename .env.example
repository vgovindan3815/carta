# ─── Database ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── LLM Providers ───────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Personal access token — needs repo:read, contents:read
GITHUB_PAT=ghp_...

# ─── Security ────────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of stored PATs
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# HTTP Basic Auth for admin destructive operations (DELETE /api/admin, DELETE /api/repos/[id])
ADMIN_USER=admin
ADMIN_PASSWORD=

# ─── Authentication (NextAuth) ───────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Users: comma-separated email:password:role  (role = viewer | editor | admin)
# Example: MAVEN_USERS=admin@example.com:changeme:admin,reader@example.com:readpass:viewer
MAVEN_USERS=

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Set after deploying — used to validate GitHub push webhook payloads
GITHUB_WEBHOOK_SECRET=
